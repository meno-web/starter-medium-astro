{
  "component": {
    "structure": {
      "type": "link",
      "href": "{{link}}",
      "style": {
        "base": {
          "padding": "var(--b-p)",
          "display": "inline-flex",
          "flexDirection": "row",
          "justifyContent": "flex-start",
          "alignItems": "stretch",
          "backgroundColor": "var(--accent)",
          "borderRadius": "var(--b-br)",
          "color": "var(--white)",
          "fontSize": "var(--te-fs)"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        "{{text}}"
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Button"
      },
      "link": {
        "type": "link",
        "default": {
          "href": "#"
        }
      }
    },
    "acceptsStyles": true
  }
}