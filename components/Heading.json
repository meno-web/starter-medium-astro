{
  "component": {
    "structure": {
      "type": "node",
      "tag": "h{{tag}}",
      "style": {
        "base": {
          "fontSize": "var(--h-fs)",
          "letterSpacing": "var(--h-ls)",
          "fontWeight": "var(--h-fw)",
          "lineHeight": "var(--h-lh)",
          "color": "var(--text)"
        },
        "tablet": {},
        "mobile": {}
      },
      "children": [
        "{{text}}"
      ]
    },
    "interface": {
      "text": {
        "type": "rich-text",
        "default": "<!--MENO_RAW_HTML-->Everything you <span class=\"custom-span\" data-meno-span=\"true\">need</span> to build professional website"
      },
      "tag": {
        "type": "number",
        "default": 1
      }
    },
    "acceptsStyles": true
  }
}