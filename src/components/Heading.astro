---
import { cx, resolveProps, richTextWithComponents } from 'meno-astro';
import { cmsComponents } from '../cmsComponents';

const __props = resolveProps(Astro, {
  text: {
    type: "rich-text",
    default: "Everything you <span class=\"custom-span\" data-meno-span=\"true\">need</span> to build professional website"
  },
  tag: { type: "number", default: 1 }
});
const { text, tag, class: className } = __props;

const __meno = { acceptsStyles: true };

const Tag_0 = `h${tag}`;
---
<Tag_0 class={cx("text-text text-(length:--h-fs) font-(number:--h-fw) leading-(--h-lh) tracking-(--h-ls)", className)}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></Tag_0>
