---
import { cx, resolveProps, richTextWithComponents } from 'meno-astro';
import { cmsComponents } from '../cmsComponents';

const __props = resolveProps(Astro, {
  text: {
    type: "rich-text",
    default: "Design and publish professional websites without writing code. Start with this template and make it yours in minutes."
  }
});
const { text, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<p class={cx("text-text text-(length:--t-fs) font-(number:--t-fw) leading-(--t-lh) tracking-(--t-ls)", className)}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></p>
